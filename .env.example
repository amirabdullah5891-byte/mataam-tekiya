# ====================================
# مطعم التكية - متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم
# ====================================

# قاعدة البيانات (PostgreSQL على Neon)
# احصل على الرابط من: https://neon.tech
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR_HOST.neon.tech/neondb?sslmode=require

# ملاحظة: على Vercel، أضف هذا المتغير من لوحة التحكم
# Settings → Environment Variables → Add
