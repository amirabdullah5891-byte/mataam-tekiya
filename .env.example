# ====================================
# مطعم التكية - ملف البيئة
# ====================================

# قاعدة البيانات - SQLite (للتطوير)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ====================================
# للتبديل إلى PostgreSQL (للإنتاج):
# ====================================
# 1. ثبّت PostgreSQL أو استخدم خدمة سحابية:
#    - Neon (مجاني): https://neon.tech
#    - Supabase (مجاني): https://supabase.com
#    - Railway: https://railway.app
#
# 2. احصل على رابط الاتصال وضعه هنا:
# DATABASE_URL=postgresql://user:password@localhost:5432/tekiya_db
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
#
# 3. بدّل المزود في schema.prisma:
#    bun run switch-db postgresql
#
# 4. شغّل الإعداد التلقائي:
#    bun run setup:postgres
#
# ====================================
# للتبديل إلى MySQL (بديل):
# ====================================
# DATABASE_URL=mysql://user:password@localhost:3306/tekiya_db
# ثم: bun run switch-db mysql
# ثم: bun run db:push

# ====================================
# متغيرات إضافية (اختيارية)
# ====================================
# NEXTAUTH_URL=http://localhost:3000
# PORT=3000
# NODE_ENV=development
