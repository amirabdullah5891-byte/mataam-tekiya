// Prisma schema for Restaurant Accounting System
// نظام حسابات مطعم التكية - أبو أمنة الشعبي
//
// ====== دعم المزودات ======
// المزود الافتراضي يُحدد عبر متغير البيئة DATABASE_PROVIDER
// - sqlite: للتطوير (افتراضي)
// - postgresql: للإنتاج والتوسع الكبير
// - mysql: بديل للإنتاج
//
// للتبديل إلى PostgreSQL:
// 1. ثبّت PostgreSQL محلياً أو استخدم خدمة سحابية (Neon, Supabase)
// 2. حدّث DATABASE_URL في .env إلى رابط PostgreSQL
//    مثال: postgresql://user:pass@host:5432/dbname?schema=public
// 3. شغّل: bun run setup:postgres (للإعداد التلقائي + الترحيل)
// أو يدوياً:
//    - DATABASE_PROVIDER=postgresql bun run db:push
//    - bun run migrate:postgres (لترحيل البيانات الموجودة)

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// المستخدمون - نظام تسجيل دخول متعدد المستخدمين
model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String   // مشفرة باستخدام scrypt
  name        String
  role        String   @default("cashier") // admin, manager, cashier
  jobTitle    String?  // المسمى الوظيفي (مدير عام، محاسب، كاشير، ويتر، شيف، إلخ)
  isActive    Boolean  @default(true)
  // الصلاحيات التفصيلية (JSON string)
  // مثال: {"invoices":true,"purchases":true,"inventory":false,"expenses":false,"suppliers":false,"reports":true,"users":false,"customerOrders":true,"customers":true,"reviews":false,"audit":false,"menu":false}
  permissions String?
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses           Expense[]
  purchases          Purchase[]
  invoices           Invoice[]
  walletTopups       WalletTransaction[]
  acceptedOrders     CustomerOrder[]
  sessions           Session[]
}

// جلسات تسجيل الدخول - بديل موثوق عن NextAuth JWT
model Session {
  id        String   @id @default(cuid())
  token     String   @unique // session token عشوائي
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

// عناصر قائمة الطعام - الأطباق والمشروبات المتاحة للبيع
model MenuItem {
  id          String         @id @default(cuid())
  name        String
  category    String
  price       Float
  cost        Float          @default(0)
  isActive    Boolean        @default(true)
  isAvailable Boolean        @default(true) // متاح حالياً (نفد من المخزون مؤقتاً)
  description String?
  imageUrl    String?        // رابط صورة الطبق (محلي أو خارجي)
  prepTime   Int?            // وقت التحضير بالدقائق
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  invoiceItems InvoiceItem[]
  orderItems  CustomerOrderItem[]
  reviews     Review[]
}

// تقييمات الأطباق من الزبائن
model Review {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  customerName String?
  customerPhone String?
  rating     Int      // 1-5 نجوم
  comment    String?
  isHidden   Boolean  @default(false) // يمكن للمدير إخفاء التقييمات المسيئة
  createdAt  DateTime @default(now())

  @@index([menuItemId])
  @@index([createdAt])
}

// إشعارات الزبائن (محاكاة SMS)
model Notification {
  id         String   @id @default(cuid())
  customerPhone String
  customerName String?
  message    String
  type       String   // order_status, promotion, etc.
  reference  String?  // رقم الطلب المرتبط
  status     String   @default("pending") // pending, sent, failed
  createdAt  DateTime @default(now())
  sentAt     DateTime?

  @@index([customerPhone])
  @@index([createdAt])
}

// الفاتورة - تمثل عملية بيع واحدة
model Invoice {
  id            String         @id @default(cuid())
  invoiceNumber String         @unique
  customerName  String?
  customerPhone String?        // رقم هاتف الزبون
  tableNumber   String?
  items         InvoiceItem[]
  subtotal      Float          @default(0)
  taxRate       Float          @default(0)
  taxAmount     Float          @default(0)
  discount      Float          @default(0)
  total         Float          @default(0)
  paidAmount    Float          @default(0)
  change        Float          @default(0)
  paymentMethod String         @default("cash")
  status        String         @default("completed")
  notes         String?
  shift         String?
  cashierId     String?
  cashier       User?          @relation(fields: [cashierId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([paymentMethod])
}

// بنود الفاتورة
model InvoiceItem {
  id         String    @id @default(cuid())
  invoiceId  String
  invoice    Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  name       String
  quantity   Int       @default(1)
  price      Float
  total      Float     @default(0)

  @@index([invoiceId])
  @@index([menuItemId])
}

// الموردون
model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  address   String?
  balance   Float      @default(0) // مستحقات للمورد
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@index([name])
}

// فواتير الشراء من الموردين
model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  items          PurchaseItem[]
  subtotal       Float          @default(0)
  total          Float          @default(0)
  paidAmount     Float          @default(0)
  status         String         @default("completed") // completed, pending, cancelled
  notes          String?
  createdById    String?
  createdBy      User?          @relation(fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())

  @@index([supplierId])
  @@index([createdAt])
  @@index([status])
}

// بنود الشراء
model PurchaseItem {
  id              String        @id @default(cuid())
  purchaseId      String
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  name            String
  quantity        Float
  unit            String?
  unitCost        Float
  total           Float         @default(0)

  @@index([purchaseId])
  @@index([inventoryItemId])
}

// عناصر المخزون - المواد الخام
model InventoryItem {
  id           String          @id @default(cuid())
  name         String
  category     String          // لحوم، خضروات، مواد جافة، مشروبات، توابل، أخرى
  unit         String          // كجم، لتر، قطعة، كيس، علبة
  quantity     Float           @default(0)
  minQuantity  Float           @default(0) // حد التنبيه
  costPerUnit  Float           @default(0) // التكلفة لكل وحدة
  isActive     Boolean         @default(true)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movements    StockMovement[]
  purchaseItems PurchaseItem[]

  @@index([category])
  @@index([isActive])
}

// حركات المخزون - سجل التغيرات
model StockMovement {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            String        // in, out, adjust
  quantity        Float
  reason          String?
  reference       String?
  createdAt       DateTime      @default(now())

  @@index([inventoryItemId])
  @@index([createdAt])
}

// المصروفات - رواتب، إيجار، كهرباء، إلخ
model Expense {
  id          String   @id @default(cuid())
  category    String   // رواتب، إيجار، كهرباء، ماء، صيانة، مشتريات، أخرى
  amount      Float
  description String?
  date        DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([category])
}

// الزبائن - أصحاب المحافظ الرقمية
model Customer {
  id        String             @id @default(cuid())
  phone     String             @unique // رقم الهاتف هو المعرف الرئيسي
  name      String?
  balance   Float              @default(0) // رصيد المحفظة بالجنيه
  isActive  Boolean            @default(true)
  notes     String?
  orders    CustomerOrder[]
  walletTransactions WalletTransaction[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([phone])
}

// معاملات المحفظة - شحن، دفع، استرجاع
model WalletTransaction {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String    // topup (شحن), payment (دفع طلب), refund (استرجاع), adjustment (تسوية)
  amount      Float     // المبلغ (موجب للشحن، سالب للدفع)
  balanceBefore Float
  balanceAfter  Float
  description String?
  reference   String?  // رقم الطلب المرتبط
  createdById String?  // المستخدم الذي قام بالعملية (للشحن يدوياً)
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
  @@index([type])
}

// طلبات الزبائن - الطلبات المرسلة عبر واجهة المنيو أو الكاشير
model CustomerOrder {
  id              String              @id @default(cuid())
  orderNumber     String              @unique
  customerId      String?
  customer        Customer?           @relation(fields: [customerId], references: [id])
  customerName    String?             // اسم الزبون (قد لا يكون مسجلاً)
  customerPhone   String?             // هاتف الزبون
  tableNumber     String?             // رقم الطاولة (للطلبات داخل المحل)
  items           CustomerOrderItem[]
  subtotal        Float               @default(0)
  deliveryFee     Float               @default(0)
  total           Float               @default(0)
  paymentMethod   String              @default("cash") // cash, wallet
  status          String              @default("pending") // pending, confirmed, preparing, ready, completed, cancelled
  notes           String?
  // حقول نوع الطلب
  orderType       String              @default("dine_in") // dine_in (داخل المحل), takeaway (سفري)
  waiterName      String?             // اسم الويتر/الكاشير معد الطلب
  address         String?             // عنوان التوصيل (للطلبات السفرية)
  itemCount       Int                 @default(0) // إجمالي عدد الأطباق (للسفري)
  acceptedById    String?
  acceptedBy      User?               @relation(fields: [acceptedById], references: [id])
  acceptedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerPhone])
}

// بنود طلب الزبون
model CustomerOrderItem {
  id          String        @id @default(cuid())
  orderId     String
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String?
  menuItem    MenuItem?     @relation(fields: [menuItemId], references: [id])
  name        String
  quantity    Int           @default(1)
  price       Float
  total       Float         @default(0)
  notes       String?       // ملاحظات على البند (بدون بصل، حار، إلخ)

  @@index([orderId])
  @@index([menuItemId])
}

// سجل الأحداث الأمنية - Audit Log
// يسجل كل عملية حساسة لأغراض المراجعة والامتثال
model AuditLog {
  id          String   @id @default(cuid())
  action      String   // login, logout, invoice_create, invoice_cancel, wallet_topup, etc.
  entityType  String   // user, invoice, customer, purchase, expense, etc.
  entityId    String?  // معرف الكيان المتأثر
  description String?  // وصف العملية
  ipAddress   String?  // عنوان IP لمن قام بالعملية
  userAgent   String?  // معلومات المتصفح
  userId      String?  // المستخدم الذي قام بالعملية (إن وجد)
  metadata    String?  // بيانات إضافية بصيغة JSON
  status      String   @default("success") // success, failed, error
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([userId])
  @@index([createdAt])
}
